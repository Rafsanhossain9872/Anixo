{
  "name": "anixo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend-core && npm run dev",
    "dev:online": "cd online-server && npm run dev",
    "dev:wt": "cd watch2gether-service && npm run start",
    "dev:chat": "cd chat-service && npm run start",
    "dev:comment": "cd comment-service && npm run start",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" \"npm run dev:online\" \"npm run dev:wt\" \"npm run dev:chat\" \"npm run dev:comment\"",
    "build": "npx vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.8.0",
    "@giphy/react-components": "^10.1.2",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.15.0",
    "dompurify": "^3.4.5",
    "emoji-picker-react": "^4.19.1",
    "hls.js": "^1.6.16",
    "html-react-parser": "^6.1.2",
    "i18next": "^26.2.0",
    "lucide-react": "^1.14.0",
    "plyr": "^3.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
